# `npm run setup` copies this file to .env. .env is never committed.

# Gemini key from https://aistudio.google.com/apikey. Optional: without it every
# AI feature shows a friendly offline state and the rest of the app still works.
# The key stays on the local server and is never sent to the browser.
GEMINI_API_KEY=

# Model for the AI tutor. Check https://aistudio.google.com/docs/models and your
# limits at https://aistudio.google.com/rate-limit, because both change.
GEMINI_MODEL=gemini-3.5-flash-lite

# Local ports. The server only ever binds to 127.0.0.1.
PORT=4317
WEB_PORT=5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=warn

# Optional overrides.
# COMPILERLAB_DATA_DIR=./data
# SQLITE_DRIVER=node:sqlite
