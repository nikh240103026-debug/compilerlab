fund=false
audit=false
update-notifier=false
# Needed for a fresh clone to install. npm's lockfile does not record better-sqlite3's
# `gypfile: false`, so a lockfile install sees its binding.gyp and runs node-gyp, which fails
# without a full C++ toolchain, even though the package ships prebuilt binaries. No dependency
# needs an install script, and `npm run setup` activates the git hooks itself.
ignore-scripts=true
