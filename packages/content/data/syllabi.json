[
  {
    "id": "gate-cs",
    "name": "GATE Computer Science: Compiler Design",
    "kind": "exam",
    "note": "Based on the Compiler Design section of the GATE CS syllabus. It can change from year to year, so check it against the official syllabus for your exam year.",
    "items": [
      { "id": "lexical-analysis", "title": "Lexical analysis", "module": "lexical-analysis" },
      { "id": "parsing", "title": "Parsing", "module": "syntax-analysis" },
      {
        "id": "sdt",
        "title": "Syntax-directed translation",
        "module": "semantic-analysis",
        "match": ["syntax-directed", "sdd", "sdt", "attribut", "dependency"]
      },
      {
        "id": "runtime",
        "title": "Runtime environments",
        "module": "runtime-environments",
        "match": ["storage", "activation", "stack", "heap", "parameter", "access", "garbage"]
      },
      { "id": "icg", "title": "Intermediate code generation", "module": "intermediate-code" },
      {
        "id": "local-opt",
        "title": "Local optimisation",
        "module": "code-optimization",
        "match": ["basic-block", "basic block", "local", "peephole"]
      },
      {
        "id": "dataflow",
        "title": "Data flow analyses: constant propagation, liveness, common subexpression elimination",
        "module": "code-optimization",
        "match": [
          "data-flow",
          "dataflow",
          "liveness",
          "live",
          "constant",
          "subexpression",
          "global"
        ]
      }
    ]
  },
  {
